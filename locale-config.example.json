// Copy this file to locale-config.json (gitignored) and adjust as needed.
// Lines starting with // are ignored. All fields are optional.
//
// Default: Codex CLI with its saved login and configured model.
// Run `codex login` and select ChatGPT to use your subscription.
// Claude Code uses its saved login too; sign in before selecting it.
// Direct API endpoints use separate API credentials and billing.
{
  // "backend": "codex",  // or "claude-code", "openai", "anthropic"
  // Leave backend unset to infer a direct API backend from base_url.
  // --backend and --model override config for a single run.
  "models": {
    // "codex": "your-codex-model",
    // "claude-code": "sonnet",
    // "openai": "your-api-model",
    // "anthropic": "your-anthropic-model"
  },

  // Direct API examples (also set the corresponding model above):
  // "base_url": "https://api.anthropic.com",
  // "base_url": "https://openrouter.ai/api/v1",
  // "base_url": "http://127.0.0.1:1234/v1",
  // API key env inferred from URL: ANTHROPIC_API_KEY, OPENROUTER_API_KEY,
  // OPENAI_API_KEY, or no key for local servers. Override when needed:
  // "api_key_env": "MY_API_KEY",
  //
  // Legacy api_format remains an alias for backend. Legacy model belongs
  // to its original backend (Claude Code if no backend/base_url was set).
  // New configs should use models to avoid passing a model to the wrong CLI.

  "parallel": 4,
  "chunk_size": 20,
  "timeout_seconds": 600
}
